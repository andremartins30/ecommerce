#-----------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit a filled-in file.
# Every variable below is validated at boot by src/server/env.ts — the app
# refuses to start if something is missing or malformed.
#-----------------------------------------------------------------------------

NODE_ENV=development

#-----------------------------------------------------------------------------
# Infrastructure
#-----------------------------------------------------------------------------
# Matches the docker-compose.yml service. Non-default ports on purpose: a
# locally installed PostgreSQL/Redis commonly already owns 5432/6379.
# Change the password before exposing the database to anything but your machine.
DATABASE_URL=postgresql://perfumaria:perfumaria@localhost:55432/perfumaria

# Optional in development. Required once rate limiting and distributed locks
# are switched on.
REDIS_URL=redis://localhost:16379

# Absolute URL the app is served from. Must use https in production.
APP_URL=http://localhost:3000

#-----------------------------------------------------------------------------
# Secrets
#-----------------------------------------------------------------------------
# Signs session and CSRF tokens. At least 32 characters of high-entropy random
# data. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-me-with-32-plus-random-characters

# Encrypts TOTP (MFA) secrets at rest so they can be decrypted again to
# generate a code — unlike a password hash, this must be reversible. At least
# 32 characters of high-entropy random data. Generate one the same way as
# SESSION_SECRET above, with a different value.
MFA_ENCRYPTION_KEY=replace-me-with-32-plus-random-characters

#-----------------------------------------------------------------------------
# Store identity
#-----------------------------------------------------------------------------
# These only seed SystemSetting on first boot. After that the admin panel is the
# source of truth, so the commercial name is never hardcoded in the codebase.
STORE_NAME=Alquimia Perfumes Artesanais
STORE_LOGO=/logo-alquimia.png
STORE_FAVICON=
STORE_PRIMARY_COLOR=#1B1B1F
STORE_EMAIL=contato@alquimia.com.br
STORE_PHONE=
STORE_WHATSAPP=
STORE_CNPJ=
STORE_ADDRESS=

#-----------------------------------------------------------------------------
# Providers
#
# Every integration sits behind an interface. The values marked (dev only) are
# in-process or on-disk fakes used to build and test the domain before real
# accounts exist; src/server/env.ts refuses to boot with any of them when
# NODE_ENV=production.
#-----------------------------------------------------------------------------

# fake (dev only) | mercadopago | pagarme | pagbank | asaas
PAYMENT_PROVIDER=fake

# fake (dev only) | melhorenvio | correios | frenet | jadlog
SHIPPING_PROVIDER=fake

# fake (dev only) | nuvemfiscal | focusnfe | plugnotas | enotas
FISCAL_PROVIDER=fake

# fake (dev only, writes to .mail-outbox/) | ses | smtp
MAIL_PROVIDER=fake

# local (dev only, writes to .uploads/) | s3
STORAGE_PROVIDER=local

# database (durable, fine for production) | sqs
QUEUE_PROVIDER=database

# fake (dev only) | viacep | brasilapi
CEP_PROVIDER=fake
